# ---------------------------------------------------------------------------
# Template — copy to web/frontend/.env. Vite dev server env. Only VITE_-prefixed vars reach the
# browser bundle, and Vite reads this at startup — restart npm run dev after
# editing. Never put a secret here: everything below ships to the client.
# ---------------------------------------------------------------------------

# Pluto backend. There is no in-code fallback for this one, so leaving it
# unset makes every component fetch "undefined/..." instead of the API.
VITE_API_BASE_URL=http://localhost:5000

# Kappa knowledge-graph service. KnowledgeGraphView.jsx falls back to
# http://localhost:8005 if unset, but set it explicitly for clarity.
VITE_GRAPH_API_BASE_URL=http://localhost:8005
